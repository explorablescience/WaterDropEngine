{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Trace Game",
            "cargo": {
                "args": [
                    "build",
                    "--bin=waterdropengine",
                    "--package=waterdropengine",
                    "--target-dir=target",
                    "--features=x11,debug,watch,tracing"
                ],
                "filter": {
                    "name": "waterdropengine",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Advanced Debug Game",
            "cargo": {
