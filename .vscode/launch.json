            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Generate Engine Doc",
            "cargo": {
                "args": [
                    "doc",
                    "--open",
                    "--all-features",
                    "--no-deps",
                    // "--document-private-items",
                    "--target-dir=target-doc"
                ]
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
